# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL URL; when empty or "local", StockSphere uses embedded Postgres engine)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stocksphere

# JWT Authentication
JWT_SECRET=stocksphere-jwt-access-secret-minimum-32-characters-key!
JWT_REFRESH_SECRET=stocksphere-jwt-refresh-secret-minimum-32-characters-key!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial Seed Credentials (used only during seeding; never stored in repo for production)
ADMIN_INITIAL_PASSWORD=Admin@StockSphere2026!
MANAGER_INITIAL_PASSWORD=Manager@StockSphere2026!
STAFF_INITIAL_PASSWORD=Staff@StockSphere2026!
